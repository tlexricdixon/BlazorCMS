@page "/posts"
@inject HttpClient Http
@using CmsModels

<h3>Post</h3>

@if (postList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <ul>
        @foreach (var post in postList)
        {
            <li><b>@post.Title</b> by @post.Author (@post.CreatedAt.ToShortDateString())</li>
        }
    </ul>
}

@code {
    private List<CmsModels.Post>? postList;

    protected override async Task OnInitializedAsync()
    {
            postList = await Http.GetFromJsonAsync<List<CmsModels.Post>>("api/post");
    }
}

